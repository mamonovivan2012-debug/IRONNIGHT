; IRON NIGHT — Godot 4 project
config_version=5

[application]
config/name="IRON NIGHT"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="First-person monster arena shooter. Desktop + mobile."

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.008, 0.012, 0.022, 1)

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
fire={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1)]}
sword={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81),Object(InputEventMouseButton,"button_index":2)]}
grenade={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":71)]}
reload={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
ui_cancel={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":_ESCAPE)]}
